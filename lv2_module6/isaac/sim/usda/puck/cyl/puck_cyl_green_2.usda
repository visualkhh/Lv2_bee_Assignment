#usda 1.0
(
    defaultPrim = "puck"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./geo.usd@
    ]
    timeCodesPerSecond = 24
    upAxis = "Z"
)

over "puck" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.02
    custom float physxRigidBody:angularDamping = 1.5
    custom float physxRigidBody:linearDamping = 0.1
    float3 xformOp:rotateXYZ = (90, 0, 0)
    float3 xformOp:scale = (0.1, 0.1, 0.1)
    double3 xformOp:translate = (0, 0, 0)
    float3 xformOp:translate:pivot = (0, 0, 0)

    over "cyl"
    {
        over "collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </puck/PhysicsMaterials/PLA> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token purpose = "guide"
        }

        def Material "Looks" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
            prepend inherits = </__class_mtl__/puck_cyl>
        )
        {
            string config:mtlx:version = "1.39"
            token outputs:mtlx:displacement.connect = </puck/cyl/Looks/mtlxdisplacement.outputs:out>
            token outputs:mtlx:surface.connect = </puck/cyl/Looks/mtlxstandard_surface.outputs:out>
            token outputs:surface.connect = </puck/cyl/Looks/mtlxstandard_preview.outputs:surface>

            def Shader "mtlxstandard_surface" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 1
                            string ogl_diff_intensity = "1"
                        }
                    }
                )
                color3f inputs:base_color (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double3 default_value = (0.8, 0.8, 0.8)
                            string ogl_diff = "1"
                        }
                    }
                )
                color3f inputs:base_color.connect = </puck/cyl/Looks/mtlxpower1.outputs:out>
                float inputs:coat (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 0
                            string ogl_coat_intensity = "1"
                        }
                    }
                )
                float inputs:coat_roughness (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 0.1
                            string ogl_coat_rough = "1"
                        }
                    }
                )
                float inputs:emission (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 0
                            string ogl_emit_intensity = "1"
                        }
                    }
                )
                color3f inputs:emission_color (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double3 default_value = (1, 1, 1)
                            string ogl_emit = "1"
                        }
                    }
                )
                float inputs:metalness (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 0
                            string ogl_metallic = "1"
                        }
                    }
                )
                vector3f inputs:normal.connect = </puck/cyl/Looks/mtlxnormalmap1.outputs:out>
                float inputs:specular (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 1
                            string ogl_spec_intensity = "1"
                        }
                    }
                )
                color3f inputs:specular_color (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double3 default_value = (1, 1, 1)
                            string ogl_spec = "1"
                        }
                    }
                )
                float inputs:specular_IOR (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 1.5
                            string ogl_ior = "1"
                        }
                    }
                )
                float inputs:specular_roughness (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 0.2
                            string ogl_rough = "1"
                        }
                    }
                )
                float inputs:specular_roughness.connect = </puck/cyl/Looks/mtlximage2.outputs:out>
                float inputs:transmission (
                    customData = {
                        dictionary HoudiniPreviewTags = {
                            double default_value = 0
                            string ogl_transparency = "1"
                        }
                    }
                )
                token outputs:out
                uniform float2 ui:nodegraph:node:pos = (-2.06776, 9.81103)
            }

            def Shader "mtlxpower1" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_power_color3"
                color3f inputs:in1.connect = </puck/cyl/Looks/mtlxmix1.outputs:out>
                color3f inputs:in2 = (2.2, 2.2, 2.2)
                color3f outputs:out
                uniform float2 ui:nodegraph:node:pos = (-5.06776, 11.1432)
            }

            def Shader "mtlxmix1" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </puck/cyl/Looks/mtlxmultiply2.outputs:out>
                color3f inputs:fg.connect = </puck/cyl/Looks/mtlximage5.outputs:out>
                float inputs:mix.connect = </puck/cyl/Looks/mtlximage4.outputs:out>
                color3f outputs:out
                uniform float2 ui:nodegraph:node:pos = (-8.06776, 13.2006)
            }

            def Shader "mtlximage5" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @../../../source/texture/puck/puck_cyl_basecolor_id2.png@
                color3f outputs:out
                uniform float2 ui:nodegraph:node:pos = (-14.0678, 17.031)
            }

            def Shader "mtlxmultiply2" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_multiply_color3FA"
                color3f inputs:in1 = (0, 0.6824, 0.2588)
                color3f inputs:in1.connect = None
                float inputs:in2.connect = </puck/cyl/Looks/mtlxinvert1.outputs:out>
                color3f outputs:out
                uniform float2 ui:nodegraph:node:pos = (-13.3796, 13.1256)
            }

            def Shader "mtlxinvert1" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_invert_float"
                float inputs:in.connect = </puck/cyl/Looks/mtlximage4.outputs:out>
                float outputs:out
                uniform float2 ui:nodegraph:node:pos = (-18.1957, 11.4206)
            }

            def Shader "mtlximage4" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @../../../source/texture/puck/puck_cyl_tagmask.png@
                float outputs:out
                uniform float2 ui:nodegraph:node:pos = (-22.0355, 10.4202)
            }

            def Shader "mtlximage2" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @../../../source/texture/puck/puck_cyl_roughness.png@
                float outputs:out
                uniform float2 ui:nodegraph:node:pos = (-11.4119, 7.56658)
            }

            def Shader "mtlxnormalmap1" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_normalmap_float"
                vector3f inputs:in.connect = </puck/cyl/Looks/mtlximage3.outputs:out>
                float inputs:scale = 2
                vector3f outputs:out
                uniform float2 ui:nodegraph:node:pos = (-11.4119, 4.16148)
            }

            def Shader "mtlximage3" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @../../../source/texture/puck/puck_cyl_normal.png@
                vector3f outputs:out
                uniform float2 ui:nodegraph:node:pos = (-14.0678, 4.53648)
            }

            def Shader "mtlxdisplacement" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "ND_displacement_float"
                token outputs:out
                uniform float2 ui:nodegraph:node:pos = (-8.75596, 1.37401)
            }

            def Shader "mtlxstandard_preview" (
                customData = {
                    bool HoudiniIsAutoCreatedShader = 1
                }
            )
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoatRoughness = 0.1
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:roughness = 0.2
                float inputs:roughness.connect = </puck/cyl/Looks/mtlxstandard_preview_texture_roughness.outputs:r>
                color3f inputs:specularColor = (1, 1, 1)
                token outputs:surface
            }

            def Shader "mtlxstandard_preview_uv" (
                customData = {
                    bool HoudiniIsAutoCreatedShader = 1
                }
            )
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                float2 inputs:fallback = (0, 0)
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "mtlxstandard_preview_texture_roughness" (
                customData = {
                    bool HoudiniIsAutoCreatedShader = 1
                }
            )
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../../source/texture/puck/puck_cyl_roughness.png@
                float2 inputs:st.connect = </puck/cyl/Looks/mtlxstandard_preview_uv.outputs:result>
                float outputs:r
            }
        }

        over "geo" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </puck/cyl/Looks>
        }
    }

    def "PhysicsMaterials"
    {
        def Material "PLA" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.4
            float physics:staticFriction = 0.35
        }
    }
}

