#usda 1.0
(
    defaultPrim = "maze"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 0.1
    startTimeCode = 1
    subLayers = [
        @./geo.usd@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "maze"
{
    def Scope "Looks"
    {
        def Material "PLA" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
            prepend inherits = </__class_mtl__/PLA>
        )
        {
            string config:mtlx:version = "1.39"
            token outputs:mtlx:displacement.connect = </maze/Looks/PLA/mtlxdisplacement.outputs:out>
            token outputs:mtlx:surface.connect = </maze/Looks/PLA/mtlxstandard_surface.outputs:out>
            token outputs:surface.connect = </maze/Looks/PLA/mtlxstandard_preview.outputs:surface>

            def Shader "mtlxstandard_surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base
                color3f inputs:base_color = (0, 0, 0.5)
                color3f inputs:base_color.connect = </maze/Looks/PLA/mtlxpower1.outputs:out>
                float inputs:coat
                float inputs:coat_roughness
                float inputs:emission
                color3f inputs:emission_color
                float inputs:metalness
                float inputs:specular
                color3f inputs:specular_color
                float inputs:specular_IOR
                float inputs:specular_roughness
                float inputs:transmission
                token outputs:out
            }

            def Shader "mtlxpower1"
            {
                uniform token info:id = "ND_power_color3"
                color3f inputs:in1 = (0.0392, 0.1608, 0.5373)
                color3f inputs:in1.connect = None
                color3f inputs:in2 = (2.2, 2.2, 2.2)
                color3f outputs:out
            }

            def Shader "mtlxdisplacement"
            {
                uniform token info:id = "ND_displacement_float"
                token outputs:out
            }

            def Shader "mtlxstandard_preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoatRoughness = 0.1
                color3f inputs:diffuseColor = (0, 0, 0.5)
                float inputs:roughness = 0.2
                color3f inputs:specularColor = (1, 1, 1)
                token outputs:surface
            }
        }

        def Material "wall" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
            prepend inherits = </__class_mtl__/wall>
        )
        {
            string config:mtlx:version = "1.39"
            token outputs:mtlx:displacement.connect = </maze/Looks/wall/mtlxdisplacement.outputs:out>
            token outputs:mtlx:surface.connect = </maze/Looks/wall/mtlxstandard_surface.outputs:out>
            token outputs:surface.connect = </maze/Looks/wall/mtlxstandard_preview.outputs:surface>

            def Shader "mtlxstandard_surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base
                color3f inputs:base_color = (0.0611, 0.0807, 0.163)
                float inputs:coat
                float inputs:coat_roughness
                float inputs:emission
                color3f inputs:emission_color
                float inputs:metalness
                float inputs:specular
                color3f inputs:specular_color
                float inputs:specular_IOR
                float inputs:specular_roughness = 0.02
                float inputs:transmission
                token outputs:out
            }

            def Shader "mtlxdisplacement"
            {
                uniform token info:id = "ND_displacement_float"
                token outputs:out
            }

            def Shader "mtlxstandard_preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoatRoughness = 0.1
                color3f inputs:diffuseColor = (0.0611, 0.0807, 0.163)
                float inputs:roughness = 0.02
                color3f inputs:specularColor = (1, 1, 1)
                token outputs:surface
            }
        }

        def Material "profile" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
            prepend inherits = </__class_mtl__/profile>
        )
        {
            string config:mtlx:version = "1.39"
            token outputs:mtlx:displacement.connect = </maze/Looks/profile/mtlxdisplacement.outputs:out>
            token outputs:mtlx:surface.connect = </maze/Looks/profile/mtlxstandard_surface.outputs:out>
            token outputs:surface.connect = </maze/Looks/profile/mtlxstandard_preview.outputs:surface>

            def Shader "mtlxstandard_surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base
                color3f inputs:base_color = (0.6667, 0.6667, 0.6667)
                float inputs:coat
                float inputs:coat_roughness
                float inputs:emission
                color3f inputs:emission_color
                float inputs:metalness = 0.847
                float inputs:specular
                color3f inputs:specular_color
                float inputs:specular_IOR
                float inputs:specular_roughness
                float inputs:transmission
                token outputs:out
            }

            def Shader "mtlxdisplacement"
            {
                uniform token info:id = "ND_displacement_float"
                token outputs:out
            }

            def Shader "mtlxstandard_preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoatRoughness = 0.1
                color3f inputs:diffuseColor = (0.6667, 0.6667, 0.6667)
                float inputs:metallic = 0.847
                float inputs:roughness = 0.2
                color3f inputs:specularColor = (1, 1, 1)
                token outputs:surface
            }
        }

        def Material "steel" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
            prepend inherits = </__class_mtl__/steel>
        )
        {
            string config:mtlx:version = "1.39"
            token outputs:mtlx:displacement.connect = </maze/Looks/steel/mtlxdisplacement.outputs:out>
            token outputs:mtlx:surface.connect = </maze/Looks/steel/mtlxstandard_surface.outputs:out>
            token outputs:surface.connect = </maze/Looks/steel/mtlxstandard_preview.outputs:surface>

            def Shader "mtlxstandard_surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base
                color3f inputs:base_color = (1, 1, 1)
                float inputs:coat
                float inputs:coat_roughness
                float inputs:emission
                color3f inputs:emission_color
                float inputs:metalness = 0.9
                float inputs:specular
                color3f inputs:specular_color
                float inputs:specular_IOR
                float inputs:specular_roughness
                float inputs:transmission
                token outputs:out
            }

            def Shader "mtlxdisplacement"
            {
                uniform token info:id = "ND_displacement_float"
                token outputs:out
            }

            def Shader "mtlxstandard_preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoatRoughness = 0.1
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.2
                color3f inputs:specularColor = (1, 1, 1)
                token outputs:surface
            }
        }
    }

    over "PLA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </maze/Looks/PLA>
    }

    over "wall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </maze/Looks/wall>
    }

    over "profile" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </maze/Looks/profile>
    }

    over "steel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </maze/Looks/steel>
    }
}

