#usda 1.0
(
    defaultPrim = "maze"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./geo.usd@
    ]
    timeCodesPerSecond = 24
    upAxis = "Z"
)

over "maze"
{
    def Scope "PhysicsMaterials"
    {
        def Material "PLA" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.4
            float physics:staticFriction = 0.35
        }
    }

    over "collision"
    {
        over "geo_45" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </maze/PhysicsMaterials/PLA> (
                bindMaterialAs = "weakerThanDescendants"
            )
            uniform token purpose = "guide"
        }

