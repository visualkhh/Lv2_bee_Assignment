#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (0.09227250775806073, 2.1612933888130654, 0.4138293411488354)
                double3 target = (-0.10613346512668381, -0.17344141382876632, 0.3016738153036488)
            }
            dictionary Right = {
                double3 position = (0.03988901330187963, -5, 0.1922440657510208)
                double radius = 1.0361764907836915
            }
            dictionary Top = {
                double3 position = (0.06884767717888385, 0.09082034010831479, 5)
                double radius = 1.88232479095459
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        string creator = "URDF USD Converter v0.3.2"
        dictionary omni_layer = {
            string authoring_layer = "./beebot.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "beebot"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "beebot" (
    prepend references = @./payloads/base.usda@
    append variantSets = "Physics"
)
{
    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link"
            {
                string isaac:nameOverride (
                    displayName = "Name Override"
                )
                rel physics:simulationOwner

                over "wheel_left_link"
                {
                    rel physics:simulationOwner

                    over "cylinder"
                    {
                        float3[] extent = [(-0.033, -0.033, -0.0075), (0.033, 0.033, 0.0075)]
                        double height = 0.015
                        rel physics:simulationOwner
                    }
                }

                over "wheel_right_link"
                {
                    string isaac:nameOverride (
                        displayName = "Name Override"
                    )
                    rel physics:simulationOwner

                    over "cylinder"
                    {
                        float3[] extent = [(-0.033, -0.033, -0.0075), (0.033, 0.033, 0.0075)]
                        double height = 0.015
                        rel physics:simulationOwner
                    }
                }

                over "pole_front_cam_link"
                {
                    string isaac:nameOverride (
                        displayName = "Name Override"
                    )
                    rel physics:simulationOwner

                    over "pole_front_cam_color_optical_frame"
                    {
                        string isaac:Description (
                            displayName = "Reference Description"
                        )
                        uniform token isaac:forwardAxis (
                            displayName = "Forward Axis"
                        )

                        def Camera "pole_front_cam_rgb" (
                            prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
                        )
                        {
                            float2 clippingRange = (0.01, 20)
                            float exposure:fStop = 5
                            float exposure:responsivity = 1.1026709
                            float exposure:time = 0.02
                            float focalLength = 15.2449
                            float focusDistance = 400
                            float horizontalAperture = 20.955
                            bool omni:kit:cameraLock = 1
                            float verticalAperture = 15.7162
                            quatd xformOp:orient = (6.123233995736766e-17, 1, 0, 0)
                            double3 xformOp:scale = (1, 1, 1)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                        }
                    }

                    over "box"
                    {
                        rel physics:simulationOwner
                    }
                }

                over "arm_base_link"
                {
                    string isaac:nameOverride (
                        displayName = "Name Override"
                    )
                    rel physics:simulationOwner

                    over "shoulder_link"
                    {
                        string isaac:nameOverride (
                            displayName = "Name Override"
                        )
                        rel physics:simulationOwner

                        over "upper_arm_link"
                        {
                            string isaac:nameOverride (
                                displayName = "Name Override"
                            )
                            rel physics:simulationOwner

                            over "forearm_link"
                            {
                                string isaac:nameOverride (
                                    displayName = "Name Override"
                                )
                                rel physics:simulationOwner

                                over "wrist_link"
                                {
                                    rel physics:simulationOwner

                                    over "gripper_link"
                                    {
                                        string isaac:nameOverride (
                                            displayName = "Name Override"
                                        )
                                        rel physics:simulationOwner

                                        over "finger_left_link"
                                        {
                                            string isaac:nameOverride (
                                                displayName = "Name Override"
                                            )
                                            rel physics:simulationOwner
                                        }

                                        over "finger_right_link"
                                        {
                                            string isaac:nameOverride (
                                                displayName = "Name Override"
                                            )
                                            rel physics:simulationOwner
                                        }

                                        over "gripper_cam_link"
                                        {
                                            string isaac:nameOverride (
                                                displayName = "Name Override"
                                            )
                                            rel physics:simulationOwner

                                            over "gripper_cam_color_optical_frame"
                                            {
                                                string isaac:Description (
                                                    displayName = "Reference Description"
                                                )
                                                uniform token isaac:forwardAxis (
                                                    displayName = "Forward Axis"
                                                )

                                                def Camera "gripper_cam_rgb" (
                                                    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
                                                )
                                                {
                                                    float2 clippingRange = (0.01, 20)
                                                    float exposure:fStop = 5
                                                    float exposure:responsivity = 1.1026709
                                                    float exposure:time = 0.02
                                                    float focalLength = 15.2449
                                                    float focusDistance = 400
                                                    float horizontalAperture = 20.955
                                                    bool omni:kit:cameraLock = 1
                                                    float verticalAperture = 15.7162
                                                    quatd xformOp:orient = (6.123233995736766e-17, 1, 0, 0)
                                                    double3 xformOp:scale = (1, 1, 1)
                                                    double3 xformOp:translate = (0, 0, 0)
                                                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                                                }
                                            }

                                            over "box"
                                            {
                                                rel physics:simulationOwner
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                over "box"
                {
                    rel physics:simulationOwner
                }

                over "box_1"
                {
                    rel physics:simulationOwner
                }

                over "box_2"
                {
                    rel physics:simulationOwner
                }

                over "box_3"
                {
                    rel physics:simulationOwner
                }

                over "box_4"
                {
                    rel physics:simulationOwner
                }

                over "sphere"
                {
                    rel physics:simulationOwner
                }

                over "sphere_1"
                {
                    rel physics:simulationOwner
                }

                over "imu_link"
                {
                    string isaac:Description (
                        displayName = "Reference Description"
                    )
                    uniform token isaac:forwardAxis (
                        displayName = "Forward Axis"
                    )

                    def IsaacImuSensor "Imu_Sensor"
                    {
                        int angularVelocityFilterWidth = 1
                        bool enabled = 1
                        int linearAccelerationFilterWidth = 1
                        int orientationFilterWidth = 1
                        token visibility = "invisible"
                        quatd xformOp:orient = (1, 0, 0, 0)
                        double3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }
                }
            }
        }
    }

    over "Physics"
    {
