#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @./scene_approach.usda@
    ]
)

# scene_approach with matte wall panels (test 11-13): the real panels are glossy, the scene copies that with
# specular_roughness 0.02 (near mirror). This variant only raises the roughness so a cuVSLAM drift run can be compared
# glossy vs matte. Same geometry -> mission/map/scene_approach_matte is a copy of scene_approach.
over "World"
{
    over "maze"
    {
        over "Looks"
        {
            over "wall"
            {
                over "mtlxstandard_surface"
                {
                    float inputs:specular_roughness = 0.5
                }

                over "mtlxstandard_preview"
                {
                    float inputs:roughness = 0.5
                }
            }
        }
    }
}
