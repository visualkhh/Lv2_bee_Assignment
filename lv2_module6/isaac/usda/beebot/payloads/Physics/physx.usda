#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "beebot"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "beebot"
{
    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysxArticulationAPI"]
            )
            {
                bool physxArticulation:enabledSelfCollisions = 1
                float physxArticulation:sleepThreshold = 0
                float physxArticulation:stabilizationThreshold = 0
            }
        }
    }

    over "Physics"
    {
        over "wheel_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.016
            float physxJoint:maxJointVelocity = 462
        }

        over "wheel_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.016
            float physxJoint:maxJointVelocity = 462
        }

        over "joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.045
            float physxJoint:maxJointVelocity = 276
        }

        over "joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.045
            float physxJoint:maxJointVelocity = 276
        }

        over "joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.045
            float physxJoint:maxJointVelocity = 276
        }

        over "joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.045
            float physxJoint:maxJointVelocity = 276
        }

        over "joint5" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.045
            float physxJoint:maxJointVelocity = 276
        }

        over "gripper_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 0.07
        }

        over "gripper_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }

    over "PhysicsMaterials"
    {
        over "wheel_rubber" (
            prepend apiSchemas = ["PhysxMaterialAPI"]
        )
        {
            # Carpet floor (11-13): rubber on carpet is lower than the converter's 1.0 / 0.9 (estimate 0.6-0.8, unmeasured).
            # Set only a step down so the sim does not slip more than the robot would; "max" = never below the floor
            # material (scenes: 0.85 / 0.70), so the contact uses these values.
            float physics:dynamicFriction = 0.8
            float physics:staticFriction = 0.9
            uniform token physxMaterial:frictionCombineMode = "max"
        }

        over "finger_pad" (
            prepend apiSchemas = ["PhysxMaterialAPI"]
        )
        {
            uniform token physxMaterial:frictionCombineMode = "max"
        }

        over "caster_ball" (
            prepend apiSchemas = ["PhysxMaterialAPI"]
        )
        {
            # Carpet floor (11-12): the small steel caster ball sinks into the pile and drags. PhysX has no rolling
            # resistance on this sphere collider, so model it as a small sliding friction (estimate, tune against the robot).
            # combine "min" keeps the ball value whatever the floor is (floor 0.85 / 0.70).
            float physics:dynamicFriction = 0.08
            float physics:staticFriction = 0.1
            uniform token physxMaterial:frictionCombineMode = "min"
        }
    }
}

